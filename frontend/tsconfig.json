{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@labelhub/low-code-engine": ["../packages/low-code-engine/src/index.ts"],
      "@labelhub/low-code-engine/*": ["../packages/low-code-engine/src/*"],
      "@/low-code": ["../packages/low-code-engine/src"],
      "@/low-code/*": ["../packages/low-code-engine/src/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "exclude": [],
  "include": ["src", "scripts"]
}
